#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
jobs=${JOBS:-$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)}
san=""
suite=""
gtest_args=()
build_dir_set=0
[[ -n ${BUILD_DIR+x} ]] && build_dir_set=1
build=${BUILD_DIR:-"$root/build"}

# Prefer clang++, else g++; leave unset only if neither exists (CMake default).
if [[ -z ${CXX+x} ]]; then
  if command -v clang++ >/dev/null 2>&1; then
    export CXX=clang++
  elif command -v g++ >/dev/null 2>&1; then
    export CXX=g++
  fi
fi

usage() {
  cat <<'USAGE'
Usage: test.sh [suite] [--san=asan|tsan|ubsan] [gtest-args...]

Suites:
  spsc   qqu_test_spsc
  all    all test targets (default)

Options:
  --san=asan|tsan|ubsan   configure+build under build-<san> (or BUILD_DIR)
  -h, --help              show this help

Env:
  BUILD_DIR   build directory (default: <repo>/build, or build-<san> with --san)
  JOBS        parallel build jobs (default: nproc)
  CXX         C++ compiler (default: clang++ if found, else g++)

Examples:
  ./scripts/test.sh
  ./scripts/test.sh spsc
  ./scripts/test.sh spsc --gtest_filter='*stress*'
  ./scripts/test.sh spsc --san=asan
  ./scripts/test.sh spsc --san=tsan --gtest_filter='*stress*:*soak*'
  BUILD_DIR=build-asan ./scripts/test.sh spsc
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --san=*)
      san=${1#--san=}
      shift
      ;;
    --san)
      [[ $# -ge 2 ]] || { echo "test.sh: --san needs a value" >&2; exit 1; }
      san=$2
      shift 2
      ;;
    -*)
      if [[ -z $suite ]]; then
        echo "test.sh: unexpected option before suite: $1" >&2
        usage >&2
        exit 1
      fi
      gtest_args+=("$1")
      shift
      ;;
    *)
      if [[ -z $suite ]]; then
        suite=$1
      else
        gtest_args+=("$1")
      fi
      shift
      ;;
  esac
done

suite=${suite:-all}

case "$san" in
  "" | asan | tsan | ubsan) ;;
  *)
    echo "test.sh: unknown sanitizer: $san (use asan|tsan|ubsan)" >&2
    exit 1
    ;;
esac

if [[ -n $san && $build_dir_set -eq 0 ]]; then
  build=$root/build-$san
fi

case "$suite" in
  spsc) targets=(qqu_test_spsc) ;;
  all)  targets=(qqu_test_spsc) ;; # add qqu_test_mpsc / qqu_test_mpmc later
  *)
    echo "unknown suite: $suite" >&2
    usage >&2
    exit 1
    ;;
esac

cmake_args=(-S "$root" -B "$build" -G Ninja)
if [[ -n $san ]]; then
  cmake_args+=(-DQQU_SANITIZER="$san")
fi

if [[ -n $san || (! -f $build/build.ninja && ! -f $build/Makefile && ! -f $build/CMakeCache.txt) ]]; then
  cmake "${cmake_args[@]}"
fi

cmake --build "$build" --target "${targets[@]}" -j"$jobs"

status=0
for t in "${targets[@]}"; do
  echo "==> $t  (build=$build${san:+ san=$san})"
  if ! "$build/$t" "${gtest_args[@]+"${gtest_args[@]}"}"; then
    status=1
  fi
done
exit "$status"
