#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
results_dir=${RESULTS_DIR:-"$root/results"}
raw_dir="$results_dir/raw"
svg_dir="$results_dir/svg"
files=("$raw_dir"/*.spsc/*.bench.csv)

if [[ ! -e ${files[0]} ]]; then
  echo "plot: no SPSC results in $raw_dir" >&2
  exit 1
fi

latest=${files[${#files[@]}-1]}
group=${latest%/*}
group=${group##*/}
mkdir -p "$svg_dir/$group"
echo "==> $latest"
uv run --project "$root/scripts/py" "$root/scripts/py/main.py" \
  --output-dir "$svg_dir/$group" "$latest"
