#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
results_dir=${RESULTS_DIR:-"$root/results"}
raw_dir="$results_dir/raw"
svg_dir="$results_dir/svg"
case "${1:-spsc}" in
  mpsc) suites=(mpsc) ;;
  spsc) suites=(spsc) ;;
  all) suites=(mpsc spsc) ;;
  *) echo 'Usage: plot [spsc|mpsc|all]' >&2; exit 1 ;;
esac

for suite in "${suites[@]}"; do
  files=("$raw_dir"/*."$suite"/*.bench.csv)
  if [[ ! -e ${files[0]} ]]; then
    echo "plot: no $suite results in $raw_dir" >&2
    exit 1
  fi
  latest=${files[${#files[@]}-1]}
  group=${latest%/*}
  group=${group##*/}
  mkdir -p "$svg_dir/$group"
  echo "==> $latest"
  uv run --project "$root/scripts/py" "$root/scripts/py/main.py" \
    --output-dir "$svg_dir/$group" "$latest"
done
