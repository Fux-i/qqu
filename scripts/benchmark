#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/lib/common.sh"
source "$(dirname "$0")/lib/metadata.sh"
source "$(dirname "$0")/lib/perf.sh"
source "$(dirname "$0")/lib/results.sh"

qqu_prefer_cxx

suite=""
full=0
do_perf=0
cpus="${QQU_CPUS:-}"
comment="${QQU_COMMENT:-}"
only="${QQU_ONLY:-}"
bench_args=()

usage() {
  cat <<'USAGE'
Usage: benchmark [suite] [options] [-- bench-args...]

Suites:
  spsc   qqu_bench_spsc
  all    all bench targets (default)

Options:
  --quick         capacity 1024, smaller N, single run (default)
  --full          all capacities with the full N and run count
  --cpus P,C      pin producer,consumer (also used with taskset if present)
  --scenario S    cross (default, different cores) or smt (same-core SMT)
  --smt           alias for --scenario smt (cpus 6,7 unless --cpus set)
  --perf          perf stat per queue (cache/branch/IPC); separate result file
  --only Q[,Q...] benchmark only the selected registry implementations
  -m, --comment C short result comment (default: scenario)
  -h, --help      show this help
  (implicit)      sets performance profile and disables turbo before runs

Env:
  BUILD_DIR     build directory (default: <repo>/build)
  RESULTS_DIR   output directory (default: <repo>/results)
  JOBS          parallel build jobs
  CXX           C++ compiler
  QQU_N QQU_RUNS QQU_CPUS   forwarded to the bench binary
  QQU_COMMENT                result comment

Examples:
  ./scripts/benchmark
  ./scripts/benchmark spsc
  ./scripts/benchmark spsc --full
  ./scripts/benchmark spsc --cpus 0,2
  ./scripts/benchmark spsc --smt
  ./scripts/benchmark spsc --perf
  ./scripts/benchmark spsc --perf --full
  ./scripts/benchmark spsc --scenario smt --cpus 0,1
  ./scripts/benchmark spsc -- --latency -n 500000
  ./scripts/plot
USAGE
}

need_arg() {
  [[ $# -ge 2 ]] || { echo "benchmark: $1 needs a value" >&2; exit 1; }
}

scenario=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --quick) full=0; shift ;;
    --full) full=1; shift ;;
    --smt) scenario=smt; shift ;;
    --perf) do_perf=1; shift ;;
    --only) need_arg "$@"; only=$2; shift 2 ;;
    --only=*) only=${1#--only=}; shift ;;
    --scenario) need_arg "$@"; scenario=$2; shift 2 ;;
    --scenario=*) scenario=${1#--scenario=}; shift ;;
    --cpus) need_arg "$@"; cpus=$2; shift 2 ;;
    --cpus=*) cpus=${1#--cpus=}; shift ;;
    -m | --comment) need_arg "$@"; comment=$2; shift 2 ;;
    --comment=*) comment=${1#--comment=}; shift ;;
    --) shift; bench_args+=("$@"); break ;;
    -*) bench_args+=("$1"); shift ;;
    *)
      if [[ -z $suite ]]; then
        suite=$1
      else
        bench_args+=("$1")
      fi
      shift
      ;;
  esac
done

if [[ -n $scenario && $scenario != cross && $scenario != smt ]]; then
  echo "benchmark: --scenario must be cross or smt" >&2
  exit 1
fi
[[ $scenario == smt && -z $cpus ]] && cpus=6,7
[[ $scenario == cross && -z $cpus ]] && cpus=6,8

suite=${suite:-all}
comment=${comment:-${scenario:-cross}}

case "$suite" in
  spsc | all) targets=(qqu_bench_spsc) ;;
  *)
    echo "unknown suite: $suite" >&2
    usage >&2
    exit 1
    ;;
esac

qqu_refuse_sanitizer
qqu_set_quiet
qqu_cmake_release "${targets[@]}"

raw_dir="$results_dir/raw"
date_stamp=$(date +%Y%m%d)
time_stamp=$(date +%H%M%S)

status=0
for t in "${targets[@]}"; do
  type=${t#qqu_bench_}
  out_dir="$raw_dir/$date_stamp.$type"
  mkdir -p "$out_dir"
  stem="$out_dir/$time_stamp.$comment"
  meta="$stem.meta.txt"
  echo "==> $t  (build=$build) -> $stem"

  if ! qqu_metadata "$t" >"$meta"; then
    status=1
    continue
  fi

  if ((do_perf)); then
    if ! qqu_run_perf "$build/$t" "$stem.perf.csv" "$only"; then
      status=1
    fi
    continue
  fi

  run=("$build/$t")
  ((full)) && run+=(--full)
  [[ -n $scenario ]] && run+=(--scenario "$scenario")
  [[ -n $cpus ]] && run+=(--cpus "$cpus")
  [[ -n $only ]] && run+=(--only "$only")
  run+=("${bench_args[@]+"${bench_args[@]}"}")

  csv_tmp="$stem.bench.csv.tmp"
  if ! qqu_with_pin "${run[@]}" | qqu_bench_to_csv >"$csv_tmp"; then
    status=1
    rm -f "$csv_tmp" "$stem.bench.csv"
  else
    mv "$csv_tmp" "$stem.bench.csv"
  fi
done
exit "$status"
